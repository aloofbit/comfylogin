<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- comfylogin: saved accounts. Our copy of MovieFrame.xml includes this
	     file at its end. MovieFrame.xml loads after AccountLogin.xml and
	     CharacterSelect.xml, so both screens exist when ComfyAccounts_OnLoad
	     runs. The border is the news box's (ServerAlertFrame). -->
	<Script file="ComfyLogin.lua"/>
	<Button name="ComfyAccountsRowTemplate" virtual="true" hidden="true">
		<Size>
			<AbsDimension x="208" y="40"/>
		</Size>
		<!-- Half the 12 between rows each, so inside the list the pointer is
		     always over a row and the glow never falls back between two. -->
		<HitRectInsets>
			<AbsInset left="0" right="0" top="-6" bottom="-6"/>
		</HitRectInsets>
		<Layers>
			<!-- The glow is not a HighlightTexture: one row glows at a time,
			     the hovered one or else the selected one, and the code decides
			     which (the owner's call, 2026-09-25). 8 past the row on every
			     side. Its alpha is set in ComfyLogin.lua. -->
			<Layer level="BACKGROUND">
				<Texture name="$parentGlow" file="Interface\Glues\CharacterSelect\Glue-CharacterSelect-Highlight" alphaMode="ADD" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="-8" y="8"/>
							</Offset>
						</Anchor>
						<Anchor point="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="8" y="-8"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString name="$parentName" inherits="GlueFontNormal" justifyH="LEFT">
					<Size>
						<AbsDimension x="170" y="14"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="10" y="-5"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentChar" inherits="GlueFontHighlightSmall" justifyH="LEFT">
					<Size>
						<AbsDimension x="170" y="12"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentName" relativePoint="BOTTOMLEFT">
							<Offset>
								<AbsDimension x="0" y="-3"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentRemove" hidden="true">
				<Size>
					<AbsDimension x="24" y="24"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT">
						<Offset>
							<AbsDimension x="-4" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						ComfyAccounts_Remove(this:GetParent().index);
					</OnClick>
					<OnEnter>
						ComfyAccounts_Hover(this:GetParent(), true);
					</OnEnter>
					<OnLeave>
						ComfyAccounts_Hover(this:GetParent(), false);
					</OnLeave>
				</Scripts>
				<NormalTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Up"/>
				<PushedTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Down"/>
				<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
			</Button>
		</Frames>
		<Scripts>
			<OnClick>
				ComfyAccounts_Select(this.index);
			</OnClick>
			<OnDoubleClick>
				ComfyAccounts_Login(this.index);
			</OnDoubleClick>
			<OnEnter>
				ComfyAccounts_Hover(this, true);
			</OnEnter>
			<OnLeave>
				ComfyAccounts_Hover(this, false);
			</OnLeave>
		</Scripts>
	</Button>
	<!-- Character select: the account's auto login character, for the
	     selected character. Right of Enter World (the owner's call,
	     2026-09-25). The look is the login screen's remember box. -->
	<CheckButton name="ComfyAutoLogin" parent="CharacterSelectUI" hidden="true">
		<Size>
			<AbsDimension x="20" y="20"/>
		</Size>
		<Anchors>
			<Anchor point="LEFT" relativeTo="CharSelectEnterWorldButton" relativePoint="RIGHT">
				<Offset>
					<AbsDimension x="4" y="3"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString inherits="GlueFontNormalSmall" text="Auto login">
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="24" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
					<Shadow>
						<Offset>
							<AbsDimension x="1" y="-1"/>
						</Offset>
						<Color r="0" g="0" b="0"/>
					</Shadow>
					<Color r="1.0" g="0.78" b="0"/>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>
				ComfyAutoLogin_OnClick();
			</OnClick>
		</Scripts>
		<NormalTexture file="Interface\Buttons\UI-CheckBox-Up"/>
		<PushedTexture file="Interface\Buttons\UI-CheckBox-Down"/>
		<HighlightTexture file="Interface\Buttons\UI-CheckBox-Highlight" alphaMode="ADD"/>
		<CheckedTexture file="Interface\Buttons\UI-CheckBox-Check"/>
		<DisabledCheckedTexture file="Interface\Buttons\UI-CheckBox-Check-Disabled"/>
	</CheckButton>
	<Frame name="ComfyAccounts" parent="AccountLoginUI" hidden="true">
		<Size>
			<AbsDimension x="248" y="100"/>
		</Size>
		<Anchors>
			<Anchor point="TOPRIGHT">
				<Offset>
					<AbsDimension x="-10" y="-15"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<BackgroundInsets>
				<AbsInset left="11" right="12" top="12" bottom="11"/>
			</BackgroundInsets>
			<TileSize>
				<AbsValue val="32"/>
			</TileSize>
			<EdgeSize>
				<AbsValue val="32"/>
			</EdgeSize>
		</Backdrop>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="ComfyAccountsPage" inherits="GlueFontDisableSmall">
					<Anchors>
						<Anchor point="RIGHT" relativePoint="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="-42" y="-14"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="ComfyAccountsRow1" inherits="ComfyAccountsRowTemplate">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="20" y="-20"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Button>
			<Button name="ComfyAccountsRow2" inherits="ComfyAccountsRowTemplate">
				<Anchors>
					<Anchor point="TOP" relativeTo="ComfyAccountsRow1" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="-12"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Button>
			<Button name="ComfyAccountsRow3" inherits="ComfyAccountsRowTemplate">
				<Anchors>
					<Anchor point="TOP" relativeTo="ComfyAccountsRow2" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="-12"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Button>
			<Button name="ComfyAccountsRow4" inherits="ComfyAccountsRowTemplate">
				<Anchors>
					<Anchor point="TOP" relativeTo="ComfyAccountsRow3" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="-12"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Button>
			<!-- Where the focus goes after a click on an account. Clearing it is
			     not enough: the login boxes take it straight back, the account
			     box with all its text selected, so one stray key (a gamepad
			     button bound to a click and a number) replaced the name.
			     Anything typed here is dropped. Off the screen, and never hidden,
			     since a hidden box cannot hold the focus. Alpha 0 was tried and
			     still drew a blinking cursor (2026-09-25). -->
			<EditBox name="ComfyAccountsSink" autoFocus="false" letters="1">
				<Size>
					<AbsDimension x="1" y="1"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="-10000" y="10000"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnTextChanged>
						if ( this:GetText() ~= "" ) then
							this:SetText("");
						end
					</OnTextChanged>
					<OnEnterPressed>
						AccountLogin_Login();
					</OnEnterPressed>
					<OnTabPressed>
						AccountLogin_FocusPassword();
					</OnTabPressed>
					<OnEscapePressed>
					</OnEscapePressed>
				</Scripts>
				<FontString inherits="GlueEditBoxFont"/>
			</EditBox>
			<Button name="ComfyAccountsPrev" hidden="true">
				<Size>
					<AbsDimension x="32" y="32"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="ComfyAccountsPage" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="-4" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						ComfyAccounts_Page(-1);
					</OnClick>
				</Scripts>
				<NormalTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Up"/>
				<PushedTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Down"/>
				<HighlightTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Highlight" alphaMode="ADD"/>
			</Button>
			<Button name="ComfyAccountsNext" hidden="true">
				<Size>
					<AbsDimension x="32" y="32"/>
				</Size>
				<Anchors>
					<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-6" y="2"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						ComfyAccounts_Page(1);
					</OnClick>
				</Scripts>
				<NormalTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Up"/>
				<PushedTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Down"/>
				<HighlightTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Highlight" alphaMode="ADD"/>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				ComfyAccounts_OnLoad();
			</OnLoad>
		</Scripts>
	</Frame>
</Ui>
